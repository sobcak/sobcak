---
import Layout from '../layouts/Layout.astro';
import HeroFrame from '../components/HeroFrame.astro';
import CatTailNav from '../components/CatTailNav.astro';
import ProofSection from '../components/ProofSection.astro';
import BleedCalculator from '../components/BleedCalculator.astro';
import PricingTiers from '../components/PricingTiers.astro';
import CollaborationRoadmap from '../components/CollaborationRoadmap.astro';
import ContactTerminal from '../components/ContactTerminal.astro';
---

<Layout>
  <CatTailNav />
  <HeroFrame />

  <main id="main">
    <ProofSection />
    <BleedCalculator />
    <PricingTiers />
    <CollaborationRoadmap />
    <ContactTerminal />
  </main>
</Layout>
