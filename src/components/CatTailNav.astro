---
/**
 * Alex channel switcher — professional geometric/ASCII operator portrait.
 * Click + Escape; full-screen #000 overlay; gold eyes track pointer while open.
 */
const links = [
  {
    id: '01',
    label: 'DŮKAZ',
    href: '#dukaz',
    channel: 'dukaz',
    external: false,
  },
  {
    id: '02',
    label: 'DIAGNOSTIKA',
    href: '#diagnostic',
    channel: 'diagnostic',
    external: false,
  },
  {
    id: '03',
    label: 'CENÍK',
    href: '#cenik',
    channel: 'cenik',
    external: false,
  },
  {
    id: '04',
    label: 'PROCES',
    href: '#proces',
    channel: 'proces',
    external: false,
  },
  {
    id: '05',
    label: 'KONTAKT',
    href: '#kontakt',
    channel: 'kontakt',
    external: false,
  },
] as const;
---

<div class="cat-tail-nav" data-cat-tail-nav>
  <button
    type="button"
    class="cat-tail-nav__trigger"
    id="cat-tail-trigger"
    aria-expanded="false"
    aria-controls="cat-tail-overlay"
    aria-label="Otevřít navigaci Alex"
  >
    <span class="cat-tail-nav__badge" aria-hidden="true">ALEX</span>
    <svg
      class="cat-tail-nav__tail"
      viewBox="0 0 72 160"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <!-- Framed operator badge -->
      <rect
        x="10"
        y="6"
        width="52"
        height="22"
        fill="none"
        stroke="currentColor"
        stroke-width="1.25"
      />
      <text
        x="36"
        y="21"
        text-anchor="middle"
        font-family="ui-monospace, monospace"
        font-size="8"
        letter-spacing="0.12em"
        fill="currentColor"
        opacity="0.9">ALEX</text>
      <!-- Spine from badge into controlled S-curve -->
      <path
        class="cat-tail-nav__curve"
        d="M36 28
           V 46
           C 36 58, 52 66, 54 84
           C 56 104, 40 116, 34 132
           C 30 142, 36 150, 46 152"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="square"
        stroke-linejoin="miter"
      />
      <!-- Sparse hatch ticks along the spine -->
      <g class="cat-tail-nav__hatch" opacity="0.4" stroke="currentColor" stroke-width="1">
        <path d="M40 56 H48" />
        <path d="M48 72 H56" />
        <path d="M48 92 H56" />
        <path d="M36 112 H44" />
        <path d="M32 128 H40" />
      </g>
      <path
        class="cat-tail-nav__tip"
        d="M46 152 L55 145 L51 156 Z"
        fill="currentColor"
      />
      <text
        x="18"
        y="150"
        font-family="ui-monospace, monospace"
        font-size="7"
        fill="currentColor"
        opacity="0.35">░▒</text>
    </svg>
  </button>

  <nav
    class="cat-tail-nav__overlay"
    id="cat-tail-overlay"
    aria-hidden="true"
    aria-label="Hlavní navigace"
    inert
  >
    <div class="cat-tail-nav__panel">
      <div class="cat-tail-nav__silhouette">
        <svg
          class="cat-tail-nav__alex"
          viewBox="0 0 280 340"
          xmlns="http://www.w3.org/2000/svg"
          role="img"
          aria-label="Alex — operátor session, silueta kočky hledící přes rameno"
          data-alex-portrait
        >
          <defs>
            <clipPath id="alex-body-clip">
              <path
                d="M42 318
                   C 52 230, 72 158, 112 118
                   C 132 98, 158 86, 180 90
                   C 214 96, 240 128, 252 178
                   C 262 220, 258 270, 252 318
                   Z"
              />
            </clipPath>
            <pattern
              id="alex-hatch"
              patternUnits="userSpaceOnUse"
              width="8"
              height="10"
            >
              <text
                x="0"
                y="8"
                font-family="ui-monospace, monospace"
                font-size="8"
                fill="#D4AF37"
                fill-opacity="0.22">░</text>
            </pattern>
          </defs>

          <!-- Monitor frame around portrait -->
          <rect
            x="12"
            y="12"
            width="256"
            height="300"
            fill="none"
            stroke="#222"
            stroke-width="1"
          />
          <rect
            x="18"
            y="18"
            width="244"
            height="288"
            fill="#050505"
            stroke="#333"
            stroke-width="1"
          />

          <!-- Shoulder / back mass -->
          <path
            d="M42 318
               C 52 230, 72 158, 112 118
               C 132 98, 158 86, 180 90
               C 214 96, 240 128, 252 178
               C 262 220, 258 270, 252 318
               Z"
            fill="#111"
            stroke="#2a2a2a"
            stroke-width="1"
          />
          <rect
            x="42"
            y="118"
            width="210"
            height="200"
            fill="url(#alex-hatch)"
            clip-path="url(#alex-body-clip)"
            opacity="0.85"
          />

          <!-- Head looking over shoulder -->
          <path
            d="M158 108
               C 148 62, 168 30, 200 34
               C 232 38, 252 64, 246 102
               C 240 134, 208 146, 176 130
               C 164 122, 158 116, 158 108
               Z"
            fill="#0a0a0a"
            stroke="#333"
            stroke-width="1"
          />
          <!-- Ears — sharp geometric -->
          <path d="M172 52 L180 18 L196 56 Z" fill="#0a0a0a" stroke="#333" stroke-width="1" />
          <path d="M216 46 L238 14 L244 58 Z" fill="#0a0a0a" stroke="#333" stroke-width="1" />
          <path d="M176 50 L182 28 L192 54" fill="none" stroke="#222" stroke-width="1" />
          <path d="M220 44 L234 24 L238 54" fill="none" stroke="#222" stroke-width="1" />

          <!-- Muzzle / cheek edge -->
          <path
            d="M204 112 C 218 120, 230 124, 234 110"
            fill="none"
            stroke="#222"
            stroke-width="1"
          />
          <!-- Nose tip -->
          <path d="M224 118 L228 114 L232 118 Z" fill="#222" />

          <!-- Eyes: sclera + tracking pupils -->
          <g class="cat-tail-nav__eyes" data-alex-eyes>
            <g class="cat-tail-nav__eye" data-alex-eye data-eye-cx="192" data-eye-cy="78">
              <ellipse
                class="cat-tail-nav__sclera"
                cx="192"
                cy="78"
                rx="9"
                ry="6.5"
                fill="#FFD700"
              />
              <circle
                class="cat-tail-nav__pupil"
                data-alex-pupil
                cx="192"
                cy="78"
                r="3.2"
                fill="#000000"
              />
            </g>
            <g class="cat-tail-nav__eye" data-alex-eye data-eye-cx="220" data-eye-cy="76">
              <ellipse
                class="cat-tail-nav__sclera"
                cx="220"
                cy="76"
                rx="9"
                ry="6.5"
                fill="#FFD700"
              />
              <circle
                class="cat-tail-nav__pupil"
                data-alex-pupil
                cx="220"
                cy="76"
                r="3.2"
                fill="#000000"
              />
            </g>
          </g>

          <!-- Operator caption -->
          <text
            x="28"
            y="292"
            fill="#D4AF37"
            fill-opacity="0.55"
            font-family="ui-monospace, monospace"
            font-size="9"
            letter-spacing="0.08em">▓▒░ ALEX ░▒▓</text>
          <text
            x="28"
            y="328"
            fill="#888888"
            font-family="ui-monospace, monospace"
            font-size="9"
            letter-spacing="0.1em">// ALEX · SESSION OPERATOR</text>
        </svg>
      </div>

      <div class="cat-tail-nav__menu">
        <p class="cat-tail-nav__menu-meta meta">// CHANNELS · SESSION SWITCHER</p>
        <ul class="cat-tail-nav__list">
          {
            links.map((link) => (
              <li>
                <a
                  class="cat-tail-nav__link"
                  href={link.href}
                  data-channel={link.channel}
                  {...(link.external
                    ? {
                        target: '_blank',
                        rel: 'noopener noreferrer',
                      }
                    : {})}
                >
                  <span class="cat-tail-nav__index">{link.id}</span>
                  <span class="cat-tail-nav__sep" aria-hidden="true">
                    {' // '}
                  </span>
                  <span class="cat-tail-nav__label">{link.label}</span>
                  {link.external && (
                    <span class="cat-tail-nav__ext meta"> design-home.cz</span>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
        <button
          type="button"
          class="cat-tail-nav__close"
          data-cat-tail-close
          aria-label="Zavřít navigaci"
        >
          [ ESC · ZAVŘÍT ]
        </button>
      </div>
    </div>
  </nav>
</div>

<script>
  import {
    switchChannel,
    subscribeChannelEnter,
    type ChannelId,
  } from '../utils/sessionBus';
  import { openContactForm, openDiagnosticQuiz } from '../utils/diagnosticBus';

  function prefersReducedMotion(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function initCatTailNav() {
    const root = document.querySelector<HTMLElement>('[data-cat-tail-nav]');
    if (!root || root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    const trigger = root.querySelector<HTMLButtonElement>('#cat-tail-trigger');
    const overlay = root.querySelector<HTMLElement>('#cat-tail-overlay');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-cat-tail-close]');
    const portrait = root.querySelector<SVGSVGElement>('[data-alex-portrait]');
    const eyes = Array.from(root.querySelectorAll<SVGGElement>('[data-alex-eye]'));
    if (!trigger || !overlay) return;

    let open = false;
    let lastFocus: HTMLElement | null = null;
    let eyeRaf = 0;
    let pendingPointer: { x: number; y: number } | null = null;
    const FADE_START = 24;
    const FADE_END = 220;
    const MAX_PUPIL = 3.6;

    const syncActiveChannel = (id: ChannelId) => {
      root.querySelectorAll<HTMLAnchorElement>('[data-channel]').forEach((link) => {
        const linkChannel = link.dataset.channel;
        const active = linkChannel === id;
        link.classList.toggle('is-active-channel', active);
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    subscribeChannelEnter(({ id }) => syncActiveChannel(id));

    const resetPupils = () => {
      eyes.forEach((eye) => {
        const pupil = eye.querySelector<SVGCircleElement>('[data-alex-pupil]');
        const cx = Number(eye.dataset.eyeCx);
        const cy = Number(eye.dataset.eyeCy);
        if (!pupil || !Number.isFinite(cx) || !Number.isFinite(cy)) return;
        pupil.setAttribute('cx', String(cx));
        pupil.setAttribute('cy', String(cy));
      });
    };

    const applyPupils = (clientX: number, clientY: number) => {
      if (!portrait || prefersReducedMotion()) return;
      const ctm = portrait.getScreenCTM();
      if (!ctm) return;
      const inv = ctm.inverse();
      const pt = portrait.createSVGPoint();
      pt.x = clientX;
      pt.y = clientY;
      const local = pt.matrixTransform(inv);

      eyes.forEach((eye) => {
        const pupil = eye.querySelector<SVGCircleElement>('[data-alex-pupil]');
        const cx = Number(eye.dataset.eyeCx);
        const cy = Number(eye.dataset.eyeCy);
        if (!pupil || !Number.isFinite(cx) || !Number.isFinite(cy)) return;

        let dx = local.x - cx;
        let dy = local.y - cy;
        const dist = Math.hypot(dx, dy) || 1;
        const scale = Math.min(1, MAX_PUPIL / dist);
        dx *= scale;
        dy *= scale;
        // Slight vertical squash so pupils stay inside elliptical sclera
        dy *= 0.72;
        pupil.setAttribute('cx', String(cx + dx));
        pupil.setAttribute('cy', String(cy + dy));
      });
    };

    const flushEyes = () => {
      eyeRaf = 0;
      if (!pendingPointer || !open) return;
      applyPupils(pendingPointer.x, pendingPointer.y);
    };

    const onPointerMove = (event: PointerEvent) => {
      if (!open || prefersReducedMotion()) return;
      pendingPointer = { x: event.clientX, y: event.clientY };
      if (!eyeRaf) eyeRaf = requestAnimationFrame(flushEyes);
    };

    const stopEyeTracking = () => {
      window.removeEventListener('pointermove', onPointerMove);
      if (eyeRaf) {
        cancelAnimationFrame(eyeRaf);
        eyeRaf = 0;
      }
      pendingPointer = null;
      resetPupils();
    };

    const startEyeTracking = () => {
      resetPupils();
      if (prefersReducedMotion()) return;
      // Window-level so tracking still works over the ALEX trigger hit-target
      window.addEventListener('pointermove', onPointerMove, { passive: true });
    };

    const syncScrollFade = () => {
      if (open) {
        trigger.style.opacity = '1';
        trigger.style.pointerEvents = 'auto';
        root.classList.remove('is-scrolled');
        return;
      }

      const y = window.scrollY || document.documentElement.scrollTop || 0;
      const t = Math.min(1, Math.max(0, (y - FADE_START) / (FADE_END - FADE_START)));
      const floor = window.matchMedia('(max-width: 767px)').matches ? 0.28 : 0;
      const opacity = Math.max(floor, 1 - t);
      trigger.style.opacity = String(opacity);
      const interactive = opacity > 0.15;
      trigger.style.pointerEvents = interactive ? 'auto' : 'none';
      root.classList.toggle('is-scrolled', !interactive);
      if (!interactive) {
        trigger.setAttribute('tabindex', '-1');
        trigger.setAttribute('aria-hidden', 'true');
      } else {
        trigger.removeAttribute('tabindex');
        trigger.removeAttribute('aria-hidden');
      }
    };

    const setOpen = (next: boolean) => {
      open = next;
      trigger.setAttribute('aria-expanded', String(next));
      overlay.setAttribute('aria-hidden', String(!next));
      root.classList.toggle('is-open', next);
      document.documentElement.classList.toggle('cat-nav-open', next);

      if (next) {
        overlay.removeAttribute('inert');
        lastFocus = document.activeElement as HTMLElement | null;
        startEyeTracking();
        requestAnimationFrame(() => {
          const active = overlay.querySelector<HTMLElement>(
            '.cat-tail-nav__link.is-active-channel',
          );
          const firstLink = overlay.querySelector<HTMLElement>('.cat-tail-nav__link');
          (active ?? firstLink ?? closeBtn)?.focus();
        });
      } else {
        stopEyeTracking();
        overlay.setAttribute('inert', '');
        syncScrollFade();
        if (trigger.getAttribute('aria-hidden') !== 'true') {
          (lastFocus ?? trigger).focus();
        } else {
          lastFocus?.focus();
        }
      }

      syncScrollFade();
    };

    const toggle = () => setOpen(!open);

    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      if (trigger.style.pointerEvents === 'none') return;
      toggle();
    });

    closeBtn?.addEventListener('click', () => setOpen(false));

    overlay.querySelectorAll<HTMLAnchorElement>('.cat-tail-nav__link').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (link.target && link.target !== '_self') return;
        event.preventDefault();
        const channel = (link.dataset.channel || '') as ChannelId;
        setOpen(false);
        if (channel === 'kontakt') {
          openContactForm({
            preserveDiagnostic: Boolean(window.__DIAGNOSTIC_STATE__),
          });
          return;
        }
        if (channel === 'diagnostic') {
          openDiagnosticQuiz();
          return;
        }
        if (channel) switchChannel(channel);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open) {
        event.preventDefault();
        setOpen(false);
      }
    });

    window.addEventListener('scroll', syncScrollFade, { passive: true });
    syncScrollFade();
  }

  initCatTailNav();
  document.addEventListener('astro:page-load', initCatTailNav);
</script>

<style is:global>
  html.cat-nav-open {
    overflow: hidden;
  }
</style>

<style>
  .cat-tail-nav {
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    position: fixed;
    inset: 0;
    z-index: 80;
    pointer-events: none;
  }

  .cat-tail-nav__trigger {
    pointer-events: auto;
    position: absolute;
    top: 0;
    right: 0;
    z-index: 2;
    display: grid;
    justify-items: end;
    gap: 0.15rem;
    padding:
      calc(var(--space-2) + var(--safe-top, 0px))
      calc(var(--space-3) + var(--safe-right, 0px))
      var(--space-2)
      var(--space-2);
    border: none;
    background: transparent;
    color: var(--color-accent);
    width: clamp(5rem, 20vw, 6rem);
    min-height: 4.5rem;
    transition: opacity 180ms var(--ease-out);
    will-change: opacity;
    touch-action: manipulation;
  }

  .cat-tail-nav.is-scrolled .cat-tail-nav__trigger {
    pointer-events: none;
  }

  .cat-tail-nav__trigger:focus-visible {
    outline: var(--border-active);
    outline-offset: 2px;
  }

  .cat-tail-nav__badge {
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    color: var(--color-accent-hot);
    opacity: 0.85;
  }

  .cat-tail-nav__tail {
    width: 100%;
    height: auto;
    transform-origin: 50% 8%;
    animation: tail-sway 4.5s var(--ease-out) infinite;
    transition: color 0.3s var(--ease-out), transform 0.3s var(--ease-out);
  }

  .cat-tail-nav__trigger:hover .cat-tail-nav__tail,
  .cat-tail-nav__trigger[aria-expanded='true'] .cat-tail-nav__tail {
    color: var(--color-accent-hot);
    transform: translateY(0.25rem) rotate(3deg);
  }

  .cat-tail-nav__overlay {
    pointer-events: none;
    position: absolute;
    inset: 0;
    background: #000000;
    transform: translateY(-100%);
    transition: transform 0.7s var(--ease-out);
    overflow: auto;
    overscroll-behavior: contain;
  }

  .cat-tail-nav.is-open .cat-tail-nav__overlay {
    pointer-events: auto;
    transform: translateY(0);
  }

  .cat-tail-nav__panel {
    min-height: 100%;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding: var(--space-8) var(--page-pad) var(--space-6);
    width: min(100% - 0px, var(--content-max));
    margin-inline: auto;
    align-items: center;
  }

  .cat-tail-nav__silhouette {
    position: relative;
    max-width: 18rem;
    margin-inline: auto;
  }

  .cat-tail-nav__alex {
    width: min(100%, 17rem);
    height: auto;
    margin-inline: auto;
    display: block;
  }

  .cat-tail-nav__eyes {
    opacity: 0;
    filter: drop-shadow(0 0 0 transparent);
    transition:
      opacity 0.55s var(--ease-out) 0.28s,
      filter 0.55s var(--ease-out) 0.28s;
  }

  .cat-tail-nav.is-open .cat-tail-nav__eyes {
    opacity: 1;
    filter: drop-shadow(0 0 10px #ffd700) drop-shadow(0 0 22px rgba(255, 215, 0, 0.45));
  }

  .cat-tail-nav__pupil {
    transition: none;
  }

  .cat-tail-nav__menu {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .cat-tail-nav__menu-meta {
    letter-spacing: 0.1em;
  }

  .cat-tail-nav__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    border-top: var(--border);
  }

  .cat-tail-nav__link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.35rem;
    padding: var(--space-3) 0;
    border-bottom: var(--border);
    color: var(--color-fg);
    text-decoration: none;
    font-size: clamp(1rem, 0.9rem + 1.2vw, 1.35rem);
    letter-spacing: 0.02em;
    transition: color 0.25s var(--ease-out), padding-inline-start 0.25s var(--ease-out);
  }

  .cat-tail-nav__link:hover,
  .cat-tail-nav__link:focus-visible {
    color: var(--color-accent-hot);
    padding-inline-start: var(--space-2);
  }

  .cat-tail-nav__link.is-active-channel {
    color: var(--color-accent-hot);
    padding-inline-start: var(--space-2);
    border-bottom-color: var(--color-accent);
  }

  .cat-tail-nav__link.is-active-channel .cat-tail-nav__index {
    color: var(--color-accent-hot);
  }

  .cat-tail-nav__index {
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .cat-tail-nav__sep {
    color: var(--color-meta);
  }

  .cat-tail-nav__label {
    text-transform: uppercase;
  }

  .cat-tail-nav__close {
    align-self: flex-start;
    margin-block-start: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: var(--border);
    color: var(--color-meta);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
  }

  .cat-tail-nav__close:hover,
  .cat-tail-nav__close:focus-visible {
    color: var(--color-accent-hot);
    border-color: var(--color-accent);
  }

  @keyframes tail-sway {
    0%,
    100% {
      transform: rotate(-2deg);
    }
    50% {
      transform: rotate(3deg);
    }
  }

  @media (min-width: 768px) {
    .cat-tail-nav__panel {
      grid-template-columns: minmax(12rem, 0.9fr) minmax(0, 1.2fr);
      gap: var(--space-8);
      padding-block-start: var(--space-12);
    }

    .cat-tail-nav__silhouette {
      margin-inline: 0;
      max-width: 22rem;
    }

    .cat-tail-nav__alex {
      width: min(100%, 20rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cat-tail-nav__tail,
    .cat-tail-nav__overlay,
    .cat-tail-nav__eyes,
    .cat-tail-nav__link {
      animation: none;
      transition: none;
    }

    .cat-tail-nav__overlay {
      transform: none;
      opacity: 0;
    }

    .cat-tail-nav.is-open .cat-tail-nav__overlay {
      opacity: 1;
    }

    .cat-tail-nav.is-open .cat-tail-nav__eyes {
      opacity: 1;
      filter: none;
    }
  }
</style>
