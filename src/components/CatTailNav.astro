---
/**
 * Alex channel switcher — geometric/ASCII portrait of the real Alex
 * (black coat, airplane ears, amber-green eyes, blep).
 *
 * The whole menu is a sheet parked above the viewport. Alex sits at its
 * bottom-right corner and his tail hangs out of the portrait frame, past the
 * sheet's bottom edge — so the tail is the only thing visible while closed.
 * Dragging it down pulls Alex and the sheet with it; past the threshold the
 * menu falls the rest of the way. Tap / Enter / Space / Esc still work.
 */
const links = [
  {
    id: '01',
    label: 'DŮKAZ',
    href: '#dukaz',
    channel: 'dukaz',
    external: false,
  },
  {
    id: '02',
    label: 'DIAGNOSTIKA',
    href: '#diagnostic',
    channel: 'diagnostic',
    external: false,
  },
  {
    id: '03',
    label: 'CENÍK',
    href: '#cenik',
    channel: 'cenik',
    external: false,
  },
  {
    id: '04',
    label: 'PROCES',
    href: '#proces',
    channel: 'proces',
    external: false,
  },
  {
    id: '05',
    label: 'KONTAKT',
    href: '#kontakt',
    channel: 'kontakt',
    external: false,
  },
] as const;
---

<div class="cat-tail-nav" data-cat-tail-nav>
  <div class="cat-tail-nav__sheet" data-cat-tail-sheet>
    <div class="cat-tail-nav__panel">
      <nav
        class="cat-tail-nav__menu"
        id="cat-tail-overlay"
        aria-hidden="true"
        aria-label="Hlavní navigace"
        data-cat-tail-inert
        inert
      >
        <p class="cat-tail-nav__menu-meta meta">// CHANNELS · SESSION SWITCHER</p>
        <ul class="cat-tail-nav__list">
          {
            links.map((link) => (
              <li>
                <a
                  class="cat-tail-nav__link"
                  href={link.href}
                  data-channel={link.channel}
                  {...(link.external
                    ? {
                        target: '_blank',
                        rel: 'noopener noreferrer',
                      }
                    : {})}
                >
                  <span class="cat-tail-nav__index">{link.id}</span>
                  <span class="cat-tail-nav__sep" aria-hidden="true">
                    {' // '}
                  </span>
                  <span class="cat-tail-nav__label">{link.label}</span>
                  {link.external && (
                    <span class="cat-tail-nav__ext meta"> design-home.cz</span>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <button
        type="button"
        class="cat-tail-nav__close"
        data-cat-tail-close
        data-cat-tail-inert
        aria-label="Zavřít navigaci"
        inert
      >
        [ ESC · ZAVŘÍT ]
      </button>

      <div class="cat-tail-nav__perch">
        <div class="cat-tail-nav__portrait">
          <div class="cat-tail-nav__art" data-alex-art aria-hidden="true">
            <p class="cat-tail-nav__role meta">// ALEX · SESSION OPERATOR</p>
            <svg
              class="cat-tail-nav__alex"
              viewBox="0 0 280 300"
              xmlns="http://www.w3.org/2000/svg"
              role="img"
              aria-label="Alex — černý kocour, operátor session: uši do stran, žlutozelené oči a vyplazená špička jazyka"
              data-alex-portrait
            >
              <defs>
                <pattern id="alex-hatch" patternUnits="userSpaceOnUse" width="8" height="10">
                  <text
                    x="0"
                    y="8"
                    font-family="ui-monospace, monospace"
                    font-size="8"
                    fill="#D4AF37"
                    fill-opacity="0.22">░</text>
                </pattern>
                <clipPath id="alex-body-clip">
                  <polygon points="48,293.5 58,238 90,198 190,198 222,238 232,293.5" />
                </clipPath>
                <clipPath id="alex-head-clip">
                  <polygon
                    points="140,66 170,69 194,88 207,120 205,152 188,178 162,194 140,198 118,194 92,178 75,152 73,120 86,88 110,69"
                  />
                </clipPath>
                <clipPath id="alex-eye-left">
                  <polygon points="93,125 101,117 124,120 132,128 123,135 102,135" />
                </clipPath>
                <clipPath id="alex-eye-right">
                  <polygon points="187,125 179,117 156,120 148,128 157,135 178,135" />
                </clipPath>
              </defs>

              <!-- Monitor frame -->
              <rect x="0.5" y="0.5" width="279" height="299" fill="none" stroke="#222" />
              <rect x="6.5" y="6.5" width="267" height="287" fill="#050505" stroke="#333" />
              <text
                x="16"
                y="24"
                fill="#D4AF37"
                fill-opacity="0.55"
                font-family="ui-monospace, monospace"
                font-size="10"
                letter-spacing="0.08em">▓▒░ ALEX ░▒▓</text>

              <!-- Tail root: from behind the body out through the bottom of the frame,
                   where the pull handle picks it up (x = 250 / 280). -->
              <path
                class="cat-tail-nav__stub"
                d="M214 266 C236 266 250 280 250 300"
                fill="none"
                stroke="currentColor"
                stroke-width="5"
              />

              <!-- Chest / shoulders -->
              <polygon
                points="48,293.5 58,238 90,198 190,198 222,238 232,293.5"
                fill="#080808"
                stroke="#D4AF37"
                stroke-opacity="0.4"
                stroke-linejoin="miter"
              />
              <rect
                x="48"
                y="198"
                width="184"
                height="96"
                fill="url(#alex-hatch)"
                clip-path="url(#alex-body-clip)"
              />

              <!-- Ears — flattened out to the sides, not perky -->
              <g stroke="#D4AF37" stroke-opacity="0.45" stroke-linejoin="miter">
                <polygon points="114,70 50,50 84,98" fill="#080808" />
                <polygon points="166,70 230,50 196,98" fill="#080808" />
              </g>
              <polygon points="104,76 62,58 88,90" fill="#1c1013" />
              <polygon points="176,76 218,58 192,90" fill="#1c1013" />

              <!-- Head — round, front-facing -->
              <polygon
                points="140,66 170,69 194,88 207,120 205,152 188,178 162,194 140,198 118,194 92,178 75,152 73,120 86,88 110,69"
                fill="#060606"
                stroke="#D4AF37"
                stroke-opacity="0.45"
                stroke-linejoin="miter"
              />
              <rect
                x="73"
                y="66"
                width="134"
                height="132"
                fill="url(#alex-hatch)"
                clip-path="url(#alex-head-clip)"
                opacity="0.45"
              />

              <!-- Skeptical brows -->
              <g fill="none" stroke="#D4AF37" stroke-opacity="0.5" stroke-width="1.5">
                <path d="M90 116 L102 111 L127 115" />
                <path d="M190 116 L178 111 L153 115" />
              </g>

              <!-- Closed lids — visible until the eyes light up on landing -->
              <g fill="none" stroke="#D4AF37" stroke-opacity="0.45" stroke-width="1.5">
                <path d="M95 127 L112 131 L130 128" />
                <path d="M185 127 L168 131 L150 128" />
              </g>

              <!-- Eyes: amber-green, half-lidded, pupils track the pointer -->
              <g class="cat-tail-nav__eyes" data-alex-eyes>
                <g data-alex-eye data-eye-cx="112.5" data-eye-cy="126.5">
                  <polygon
                    points="93,125 101,117 124,120 132,128 123,135 102,135"
                    fill="#D2DC6E"
                    stroke="#7D8A2E"
                    stroke-width="0.75"
                  />
                  <g clip-path="url(#alex-eye-left)">
                    <ellipse data-alex-pupil cx="112.5" cy="126.5" rx="3.4" ry="6.2" fill="#000" />
                  </g>
                </g>
                <g data-alex-eye data-eye-cx="167.5" data-eye-cy="126.5">
                  <polygon
                    points="187,125 179,117 156,120 148,128 157,135 178,135"
                    fill="#D2DC6E"
                    stroke="#7D8A2E"
                    stroke-width="0.75"
                  />
                  <g clip-path="url(#alex-eye-right)">
                    <ellipse data-alex-pupil cx="167.5" cy="126.5" rx="3.4" ry="6.2" fill="#000" />
                  </g>
                </g>
              </g>

              <!-- Whiskers -->
              <g fill="none" stroke="#5C5C5C" stroke-width="0.8">
                <path d="M116 164 L60 154" />
                <path d="M116 168 L56 170" />
                <path d="M116 172 L62 186" />
                <path d="M164 164 L220 154" />
                <path d="M164 168 L224 170" />
                <path d="M164 172 L218 186" />
              </g>

              <!-- Nose, mouth, blep -->
              <polygon points="132,150 148,150 140,159" fill="#1A1A1A" stroke="#3A3A3A" stroke-width="0.75" />
              <path
                d="M140 159 V166 M126 169 L134 173 L140 166 L146 173 L154 169"
                fill="none"
                stroke="#3A3A3A"
                stroke-width="1.25"
              />
              <polygon points="136.5,170.5 143.5,170.5 143.5,176 140,179.5 136.5,176" fill="#E8A0A8" />
            </svg>
          </div>

          <button
            type="button"
            class="cat-tail-nav__trigger"
            id="cat-tail-trigger"
            aria-expanded="false"
            aria-controls="cat-tail-overlay"
            aria-label="Otevřít navigaci – zatáhnout Alexe za ocas"
          >
            <svg
              class="cat-tail-nav__tail"
              viewBox="0 0 56 200"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
              focusable="false"
            >
              <!-- Same units and stroke as the portrait, so it continues the stub exactly -->
              <path
                d="M28 0 V36 C28 60 43 70 43 96 C43 122 21 130 19 154 C18 170 27 181 39 182"
                fill="none"
                stroke="currentColor"
                stroke-width="5"
              />
              <g stroke="currentColor" stroke-width="1" opacity="0.45">
                <path d="M33 22 H41" />
                <path d="M36 58 H44" />
                <path d="M48 96 H55" />
                <path d="M35 128 H43" />
                <path d="M24 158 H32" />
              </g>
              <path d="M38 174 L54 183 L38 190 Z" fill="currentColor" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import {
    switchChannel,
    subscribeChannelEnter,
    type ChannelId,
  } from '../utils/sessionBus';
  import { openContactForm, openDiagnosticQuiz } from '../utils/diagnosticBus';

  const LABEL_OPEN = 'Otevřít navigaci – zatáhnout Alexe za ocas';
  const LABEL_CLOSE = 'Zavřít navigaci';

  /** Scroll range (px) over which the hanging tail fades out. */
  const FADE_START = 24;
  const FADE_END = 220;

  /** Pointer travel before a press counts as a pull rather than a tap. */
  const PULL_SLOP = 6;
  /** Pull distance that commits to opening. */
  const PULL_OPEN_DISTANCE = 100;
  /** Downward flick (px/ms) that commits even on a short pull. */
  const PULL_FLICK_VELOCITY = 0.55;
  const PULL_FLICK_MIN_DISTANCE = 24;
  /** The tail gives this much before Alex starts moving. */
  const TAIL_MAX_STRETCH = 26;
  const TAIL_STRETCH_EASE = 48;
  const TAIL_MAX_LEAN = 0.6;

  const PUPIL_MAX_X = 6.5;
  const PUPIL_MAX_Y = 2.4;
  const PUPIL_FULL_REACH = 90;

  type Pull = {
    pointerId: number;
    startX: number;
    startY: number;
    x: number;
    y: number;
    lastT: number;
    velocity: number;
    engaged: boolean;
  };

  function prefersReducedMotion(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function initCatTailNav() {
    const root = document.querySelector<HTMLElement>('[data-cat-tail-nav]');
    if (!root || root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    const sheet = root.querySelector<HTMLElement>('[data-cat-tail-sheet]');
    const trigger = root.querySelector<HTMLButtonElement>('#cat-tail-trigger');
    const menu = root.querySelector<HTMLElement>('#cat-tail-overlay');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-cat-tail-close]');
    const art = root.querySelector<HTMLElement>('[data-alex-art]');
    const portrait = root.querySelector<SVGSVGElement>('[data-alex-portrait]');
    const eyes = Array.from(root.querySelectorAll<SVGGElement>('[data-alex-eye]'));
    const inertTargets = Array.from(root.querySelectorAll<HTMLElement>('[data-cat-tail-inert]'));
    if (!sheet || !trigger || !menu) return;

    let open = false;
    let lastFocus: HTMLElement | null = null;

    let pull: Pull | null = null;
    let pullRaf = 0;
    let swallowClick = false;

    let eyeRaf = 0;
    let pendingPointer: { x: number; y: number } | null = null;

    const syncActiveChannel = (id: ChannelId) => {
      root.querySelectorAll<HTMLAnchorElement>('[data-channel]').forEach((link) => {
        const linkChannel = link.dataset.channel;
        const active = linkChannel === id;
        link.classList.toggle('is-active-channel', active);
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    subscribeChannelEnter(({ id }) => syncActiveChannel(id));

    /* ── Eyes ── */

    const resetPupils = () => {
      eyes.forEach((eye) => {
        eye.querySelector('[data-alex-pupil]')?.removeAttribute('transform');
      });
    };

    const applyPupils = (clientX: number, clientY: number) => {
      const ctm = portrait?.getScreenCTM();
      if (!portrait || !ctm) return;
      const point = portrait.createSVGPoint();
      point.x = clientX;
      point.y = clientY;
      const local = point.matrixTransform(ctm.inverse());

      eyes.forEach((eye) => {
        const pupil = eye.querySelector('[data-alex-pupil]');
        const cx = Number(eye.dataset.eyeCx);
        const cy = Number(eye.dataset.eyeCy);
        if (!pupil || !Number.isFinite(cx) || !Number.isFinite(cy)) return;

        const dx = local.x - cx;
        const dy = local.y - cy;
        const distance = Math.hypot(dx, dy) || 1;
        const reach = Math.min(1, distance / PUPIL_FULL_REACH);
        const x = (dx / distance) * reach * PUPIL_MAX_X;
        const y = (dy / distance) * reach * PUPIL_MAX_Y;
        pupil.setAttribute('transform', `translate(${x.toFixed(2)} ${y.toFixed(2)})`);
      });
    };

    const onEyePointerMove = (event: PointerEvent) => {
      pendingPointer = { x: event.clientX, y: event.clientY };
      if (eyeRaf) return;
      eyeRaf = requestAnimationFrame(() => {
        eyeRaf = 0;
        if (open && pendingPointer) applyPupils(pendingPointer.x, pendingPointer.y);
      });
    };

    const startEyeTracking = () => {
      resetPupils();
      if (prefersReducedMotion()) return;
      window.addEventListener('pointermove', onEyePointerMove, { passive: true });
    };

    const stopEyeTracking = () => {
      window.removeEventListener('pointermove', onEyePointerMove);
      if (eyeRaf) cancelAnimationFrame(eyeRaf);
      eyeRaf = 0;
      pendingPointer = null;
      resetPupils();
    };

    /* ── Scroll fade of the hanging tail ── */

    const syncScrollFade = () => {
      if (open || pull?.engaged) {
        trigger.style.opacity = '1';
        trigger.style.pointerEvents = 'auto';
        trigger.removeAttribute('tabindex');
        trigger.removeAttribute('aria-hidden');
        root.classList.remove('is-scrolled');
        return;
      }

      const y = window.scrollY || document.documentElement.scrollTop || 0;
      const t = Math.min(1, Math.max(0, (y - FADE_START) / (FADE_END - FADE_START)));
      const floor = window.matchMedia('(max-width: 767px)').matches ? 0.28 : 0;
      const opacity = Math.max(floor, 1 - t);
      trigger.style.opacity = String(opacity);
      const interactive = opacity > 0.15;
      trigger.style.pointerEvents = interactive ? 'auto' : 'none';
      root.classList.toggle('is-scrolled', !interactive);
      if (!interactive) {
        trigger.setAttribute('tabindex', '-1');
        trigger.setAttribute('aria-hidden', 'true');
      } else {
        trigger.removeAttribute('tabindex');
        trigger.removeAttribute('aria-hidden');
      }
    };

    /* ── Open / close ── */

    const setOpen = (next: boolean) => {
      open = next;
      trigger.setAttribute('aria-expanded', String(next));
      trigger.setAttribute('aria-label', next ? LABEL_CLOSE : LABEL_OPEN);
      menu.setAttribute('aria-hidden', String(!next));
      art?.setAttribute('aria-hidden', String(!next));
      inertTargets.forEach((target) => target.toggleAttribute('inert', !next));
      root.classList.toggle('is-open', next);
      document.documentElement.classList.toggle('cat-nav-open', next);

      if (next) {
        lastFocus = document.activeElement as HTMLElement | null;
        startEyeTracking();
        requestAnimationFrame(() => {
          const active = menu.querySelector<HTMLElement>('.cat-tail-nav__link.is-active-channel');
          const firstLink = menu.querySelector<HTMLElement>('.cat-tail-nav__link');
          // The sheet is still falling; don't let focus try to scroll it into view.
          (active ?? firstLink ?? closeBtn)?.focus({ preventScroll: true });
        });
      } else {
        stopEyeTracking();
        syncScrollFade();
        if (trigger.getAttribute('aria-hidden') !== 'true') {
          (lastFocus ?? trigger).focus({ preventScroll: true });
        } else {
          lastFocus?.focus({ preventScroll: true });
        }
      }

      syncScrollFade();
    };

    /* ── Pull the tail ── */

    const clearPullStyles = () => {
      root.style.removeProperty('--pull');
      trigger.style.removeProperty('--tail-rot');
      trigger.style.removeProperty('--tail-sx');
      trigger.style.removeProperty('--tail-sy');
    };

    const renderPull = () => {
      pullRaf = 0;
      if (!pull?.engaged) return;

      const dx = pull.x - pull.startX;
      const dy = Math.max(0, pull.y - pull.startY);
      const tailLength = trigger.offsetHeight || 1;

      // The tail stretches first, then drags the sheet (and Alex) behind it.
      const stretch = TAIL_MAX_STRETCH * (1 - Math.exp(-dy / TAIL_STRETCH_EASE));
      const sheetPull = Math.min(sheet.offsetHeight, dy - stretch);

      // Lean and lengthen so the tip stays under the pointer.
      const reach = tailLength + stretch;
      const lean = Math.max(-TAIL_MAX_LEAN, Math.min(TAIL_MAX_LEAN, Math.atan2(dx, reach)));
      const scaleY = reach / Math.cos(lean) / tailLength;

      root.style.setProperty('--pull', `${sheetPull.toFixed(1)}px`);
      trigger.style.setProperty('--tail-rot', `${((-lean * 180) / Math.PI).toFixed(2)}deg`);
      trigger.style.setProperty('--tail-sy', scaleY.toFixed(4));
      trigger.style.setProperty('--tail-sx', (1 / Math.sqrt(scaleY)).toFixed(4));
    };

    const finishPull = (event: PointerEvent, cancelled: boolean) => {
      const state = pull;
      if (!state || event.pointerId !== state.pointerId) return;
      pull = null;

      if (trigger.hasPointerCapture(state.pointerId)) {
        trigger.releasePointerCapture(state.pointerId);
      }
      if (pullRaf) cancelAnimationFrame(pullRaf);
      pullRaf = 0;

      // Never left the slop radius: it was a tap, the click handler takes it.
      if (!state.engaged) return;

      // The click that follows a drag must not toggle the menu again.
      swallowClick = true;
      window.setTimeout(() => {
        swallowClick = false;
      }, 250);

      const distance = Math.max(0, state.y - state.startY);
      const openDistance = Math.min(PULL_OPEN_DISTANCE, window.innerHeight * 0.22);
      const flicked =
        event.timeStamp - state.lastT < 80 &&
        state.velocity > PULL_FLICK_VELOCITY &&
        distance > PULL_FLICK_MIN_DISTANCE;
      const shouldOpen = !cancelled && (distance >= openDistance || flicked);

      // One style pass: the sheet transitions from wherever the hand left it,
      // either falling open or recoiling shut.
      root.classList.remove('is-dragging');
      clearPullStyles();
      if (shouldOpen) {
        setOpen(true);
      } else {
        document.documentElement.classList.remove('cat-nav-open');
        syncScrollFade();
      }
    };

    trigger.addEventListener('pointerdown', (event) => {
      if (open || pull || prefersReducedMotion()) return;
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      if (trigger.style.pointerEvents === 'none') return;

      pull = {
        pointerId: event.pointerId,
        startX: event.clientX,
        startY: event.clientY,
        x: event.clientX,
        y: event.clientY,
        lastT: event.timeStamp,
        velocity: 0,
        engaged: false,
      };
      try {
        // Keeps the pull alive when the pointer leaves the thin tail.
        trigger.setPointerCapture(event.pointerId);
      } catch {
        // Pointer already gone (e.g. cancelled mid-dispatch); the pull just ends early.
      }
    });

    trigger.addEventListener('pointermove', (event) => {
      if (!pull || event.pointerId !== pull.pointerId) return;

      const dt = event.timeStamp - pull.lastT;
      if (dt > 0) {
        const instant = (event.clientY - pull.y) / dt;
        pull.velocity = pull.velocity * 0.3 + instant * 0.7;
      }
      pull.x = event.clientX;
      pull.y = event.clientY;
      pull.lastT = event.timeStamp;

      if (!pull.engaged) {
        if (Math.hypot(pull.x - pull.startX, pull.y - pull.startY) < PULL_SLOP) return;
        pull.engaged = true;
        root.classList.add('is-dragging');
        document.documentElement.classList.add('cat-nav-open');
      }

      if (!pullRaf) pullRaf = requestAnimationFrame(renderPull);
    });

    trigger.addEventListener('pointerup', (event) => finishPull(event, false));
    trigger.addEventListener('pointercancel', (event) => finishPull(event, true));
    trigger.addEventListener('lostpointercapture', (event) => finishPull(event, true));

    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      if (swallowClick) {
        swallowClick = false;
        return;
      }
      if (trigger.style.pointerEvents === 'none') return;
      setOpen(!open);
    });

    closeBtn?.addEventListener('click', () => setOpen(false));

    menu.querySelectorAll<HTMLAnchorElement>('.cat-tail-nav__link').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (link.target && link.target !== '_self') return;
        event.preventDefault();
        const channel = (link.dataset.channel || '') as ChannelId;
        setOpen(false);
        if (channel === 'kontakt') {
          openContactForm({
            preserveDiagnostic: Boolean(window.__DIAGNOSTIC_STATE__),
          });
          return;
        }
        if (channel === 'diagnostic') {
          openDiagnosticQuiz();
          return;
        }
        if (channel) switchChannel(channel);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open) {
        event.preventDefault();
        setOpen(false);
      }
    });

    window.addEventListener('scroll', syncScrollFade, { passive: true });
    syncScrollFade();
  }

  initCatTailNav();
  document.addEventListener('astro:page-load', initCatTailNav);
</script>

<style is:global>
  html.cat-nav-open {
    overflow: hidden;
  }
</style>

<style>
  .cat-tail-nav {
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    /* Closing / letting go: snaps back up with a little overshoot. */
    --ease-recoil: cubic-bezier(0.3, 1.35, 0.5, 1);
    /* Opening: gravity. Accelerates, lands, one small bounce. */
    --ease-fall: cubic-bezier(0.55, 0, 0.85, 0.45);
    /* Portrait width; the tail is sized as a fraction of it so both scale together. */
    --alex-w: min(clamp(9.5rem, 44vw, 12rem), 30vh);
    /* Gap between the portrait frame and the sheet's bottom edge. */
    --perch-pad: var(--space-3);
    position: fixed;
    inset: 0;
    z-index: 80;
    pointer-events: none;
  }

  @supports (transition-timing-function: linear(0, 1)) {
    .cat-tail-nav {
      --ease-fall: linear(
        0,
        0.024 10%,
        0.098 20%,
        0.22 30%,
        0.39 40%,
