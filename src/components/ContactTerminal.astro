---
/**
 * Regional page footer (contact form lives inside BleedCalculator #kontakt panel).
 */
---

<footer class="site-footer page" role="contentinfo">
  <p class="site-footer__region">Berounsko &amp; Praha</p>
  <p class="site-footer__sig">// Na architekturu dohlíží Oliver</p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block-start: var(--space-4);
    border-block-start: var(--border);
    max-width: 48rem;
    margin-inline: auto;
  }

  .site-footer__region {
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-fg);
    max-width: none;
  }

  .site-footer__sig {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-meta);
    letter-spacing: 0.02em;
    max-width: none;
  }
</style>
